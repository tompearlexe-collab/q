local function applyFullBright(enable)
    if enable then
        pcall(function()
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 9e9
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
            for _, effect in pairs(Lighting:GetChildren()) do
                if effect:IsA("PostEffect") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect") then
                    if OriginalEffectStates[effect] == nil then OriginalEffectStates[effect] = effect.Enabled end
                    effect.Enabled = false
                end
            end
        end)
    else
        pcall(function()
            Lighting.Brightness = OriginalLighting.Brightness
            Lighting.ClockTime = OriginalLighting.ClockTime
            Lighting.FogEnd = OriginalLighting.FogEnd
            Lighting.GlobalShadows = OriginalLighting.GlobalShadows
            Lighting.Ambient = OriginalLighting.Ambient
            Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
            Lighting.ColorShift_Top = OriginalLighting.ColorShift_Top
            Lighting.ColorShift_Bottom = OriginalLighting.ColorShift_Bottom
            for _, effect in pairs(Lighting:GetChildren()) do
                if effect:IsA("PostEffect") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect") then
                    if OriginalEffectStates[effect] ~= nil then effect.Enabled = OriginalEffectStates[effect] else effect.Enabled = true end
                end
            end
        end)
    end
end

-- ==================== OPTIMIZED FIX LAG SYSTEM ====================
local fixLagConnection = nil
local function applyFixLag(enable)
    if enable then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.Brightness = 1
            local existingSky = Lighting:FindFirstChildOfClass("Sky")
            if not existingSky then existingSky = Instance.new("Sky", Lighting) end
            existingSky.SkyboxBk, existingSky.SkyboxDn, existingSky.SkyboxFt, existingSky.SkyboxLf, existingSky.SkyboxRt, existingSky.SkyboxUp = "rbxassetid://0", "rbxassetid://0", "rbxassetid://0", "rbxassetid://0", "rbxassetid://0", "rbxassetid://0"
            
            -- Quét một lần duy nhất với task.defer để không làm nghẽn luồng chính
            task.defer(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                        if not obj:FindFirstChild("UniversalESP") then
                            OriginalPartMaterials[obj] = obj.Material
                            obj.Material = Enum.Material.Plastic
                            obj.Reflectance = 0
                        end
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                        obj.Enabled = false
                    end
                end
            end)
            
            -- Lắng nghe sự kiện nhẹ nhàng khi có object mới sinh ra
            fixLagConnection = workspace.DescendantAdded:Connect(function(obj)
                if not State.FixLag then return end
                task.defer(function()
                    if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                        if not obj:FindFirstChild("UniversalESP") then
                            OriginalPartMaterials[obj] = obj.Material
                            obj.Material = Enum.Material.Plastic
                            obj.Reflectance = 0
                        end
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                        obj.Enabled = false
                    end
                end)
            end)
            table.insert(Connections, fixLagConnection)
        end)
    else
        pcall(function()
            if fixLagConnection then
                fixLagConnection:Disconnect()
                fixLagConnection = nil
            end
            for part, mat in pairs(OriginalPartMaterials) do
                if part and part.Parent then
                    pcall(function() part.Material = mat end)
                end
            end
            OriginalPartMaterials = {}
        end)
    end
end

