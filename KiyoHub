local isUnloaded = false
local function UnloadScript()
    if isUnloaded then return end
    isUnloaded = true
    for k in pairs(State) do if type(State[k]) == "boolean" then State[k] = false end end
    applyFullBright(false)
    applyFixLag(false)
    if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = 70 end
    Workspace.Gravity = 196.2

    local char = LocalPlayer.Character
    if char then
        applyRagdoll(char, false)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed, hum.JumpPower, hum.AutoRotate, hum.PlatformStand = 16, 50, true, false end
    end

    if flyBv then pcall(function() flyBv:Destroy() end) flyBv = nil end
    if flyBg then pcall(function() flyBg:Destroy() end) flyBg = nil end

    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local highlight = p.Character:FindFirstChild("UniversalESP") if highlight then highlight:Destroy() end
            local nameTag = p.Character:FindFirstChild("ESPNameTag") if nameTag then nameTag:Destroy() end
            for _, part in pairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.LocalTransparencyModifier = 0
                    if OriginalHitboxSizes[part] then part.Size, part.Transparency, part.CanCollide = OriginalHitboxSizes[part], 0, true end
                end
            end
        end
    end

    applyXRay(false)
    if CurrentSound then pcall(function() CurrentSound:Stop() CurrentSound:Destroy() end) CurrentSound = nil end
    if AirWalkPlatform then pcall(function() AirWalkPlatform:Destroy() end) end
    for _, conn in pairs(Connections) do pcall(function() conn:Disconnect() end) end
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() Rayfield:Destroy() end)
end

