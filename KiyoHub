local loopTimer = 0
local espUpdateTimer = 0
local antiTouchTimer = 0
local hitboxUpdateTimer = 0

local function isMM2()
    return game.PlaceId == 142823291 or workspace:FindFirstChild("GunDrop") ~= nil or LocalPlayer.Backpack:FindFirstChild("Revolver") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Revolver"))
end

local function getClosestPlayerToHead()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myHrp = myChar.HumanoidRootPart
    local isSheriffOrHero = isMM2() and (myChar:FindFirstChild("Revolver") or LocalPlayer.Backpack:FindFirstChild("Revolver"))

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local head = p.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local isValid = true
                if isMM2() and isSheriffOrHero then
                    if not (p.Character:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife")) then isValid = false end
                else
                    if p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then isValid = false end
                end
                if isValid then
                    local dist = (head.Position - myHrp.Position).Magnitude
                    if dist < shortestDistance then shortestDistance = dist closestPlayer = p end
                end
            end
        end
    end
    return closestPlayer
end

-- ==================== RENDERSTEPPED LOOP (ĐÃ TỐI ƯU CỰC KỲ GỌN NHẸ) ====================
table.insert(Connections, RunService.RenderStepped:Connect(function(delta)
    if isUnloaded then return end
    
    if State.Stretched and workspace.CurrentCamera then
        pcall(function()
            local res = State.StretchedValue
            workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, res, 0, 0, 0, 1)
        end)
    end

    if State.FlyActive and flyRootPart and flyRootPart.Parent and flyHumanoid and workspace.CurrentCamera then
        local moveDir = flyHumanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            flyBv.Velocity = moveDir * flySpeed + Vector3.new(0, Camera.CFrame.LookVector.Y * flySpeed * (moveDir.Z ~= 0 and 1 or 0), 0)
        else
            flyBv.Velocity = Vector3.new(0, 0.1, 0)
        end
        flyBg.CFrame = Camera.CFrame
    end

    if State.Aimbot then
        pcall(function()
            local target = getClosestPlayerToHead()
            if target and target.Character then
                local head = target.Character:FindFirstChild("Head")
                if head and Camera then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, head.Position), 0.9)
                end
            end
        end)
    end

    if State.TimeRewind then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
            local hrp, hum = char.HumanoidRootPart, char.HumanoidOfClass or char:FindFirstChildOfClass("Humanoid")
            if not State.TimeRewindActive then
                table.insert(RewindHistory, 1, { CFrame = hrp.CFrame, Velocity = hrp.AssemblyLinearVelocity, State = hum:GetState() })
                if #RewindHistory > MAX_REWIND_FRAMES then table.remove(RewindHistory, #RewindHistory) end
            else
                if #RewindHistory > 0 then
                    local targetData = table.remove(RewindHistory, 1)
                    if targetData then
                        hrp.CFrame = hrp.CFrame:Lerp(targetData.CFrame, 0.5)
                        pcall(function() hrp.AssemblyLinearVelocity = targetData.Velocity hum:ChangeState(targetData.State) end)
                    end
                else
                    State.TimeRewindActive = false SubRewindBtn.BackgroundColor3, SubRewindBtn.TextColor3, SubRewindStroke.Color = Color3.fromRGB(240, 240, 245), Color3.fromRGB(40, 40, 50), Color3.fromRGB(200, 200, 210)
                end
            end
        end
    end

    if State.FakeLag and State.FakeLagActive then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and FakeLagSavedCFrame then char.HumanoidRootPart.CFrame = FakeLagSavedCFrame end
    end

    if State.Spin then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(500), 0) end
    end

    if State.AnimationSpeed then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                local animator = char.Humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in pairs(animator:GetPlayingAnimationTracks()) do if track.Speed ~= 40 then track:AdjustSpeed(40) end end
                end
            end
        end)
    end

    hitboxUpdateTimer = hitboxUpdateTimer + delta
    if State.HitboxExpander then
        if hitboxUpdateTimer >= 0.5 then -- Giảm tần suất quét hitbox xuống 0.5s để mượt mà tuyệt đối
            hitboxUpdateTimer = 0
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if not OriginalHitboxSizes[hrp] then OriginalHitboxSizes[hrp] = hrp.Size end
                        pcall(function() hrp.Size, hrp.Transparency, hrp.CanCollide = Vector3.new(15, 15, 15), 0.7, false end)
                    end
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and OriginalHitboxSizes[hrp] then
                    pcall(function() hrp.Size, hrp.Transparency, hrp.CanCollide = OriginalHitboxSizes[hrp], 0, true end)
                end
            end
        end
    end

    if State.LoopPeople and TargetPlayer and TargetPlayer.Character then
        local char, targetChar = LocalPlayer.Character, TargetPlayer.Character
        if char and targetChar then
            local hrp, targetHrp = char:FindFirstChild("HumanoidRootPart"), targetChar:FindFirstChild("HumanoidRootPart")
            if hrp and targetHrp then
                loopTimer = loopTimer + delta * 18
                hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1.3 + (math.sin(loopTimer) * 0.85))
            end
        end
    end

    if State.AirWalk then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
            local hrp, hum = char.HumanoidRootPart, char:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                AirWalkPlatform.CanCollide = true
                local hipHeight = (hum.RigType == Enum.HumanoidRigType.R6) and 2 or hum.HipHeight
                AirWalkPlatform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - (hipHeight + (hrp.Size.Y / 2) + 0.5), hrp.Position.Z)
            else AirWalkPlatform.CanCollide = false end
        else AirWalkPlatform.CanCollide = false end
    else AirWalkPlatform.CanCollide = false end

    if State.ShiftLock and State.ShiftLockActive then
        local camera, char = workspace.CurrentCamera, LocalPlayer.Character
        if camera and char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.AutoRotate = false
            local _, y = camera.CFrame:ToOrientation()
            char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position) * CFrame.Angles(0, y, 0)
        end
    else
        local char = LocalPlayer.Character if char and char:FindFirstChildOfClass("Humanoid") then char.Humanoid.AutoRotate = true end
    end

    if not State.Aimbot and workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = State.FOV end

    espUpdateTimer = espUpdateTimer + delta
    if State.ESP then
        if espUpdateTimer >= 0.2 then -- Tăng thời gian cập nhật ESP lên 0.2s để giảm tải hoàn toàn
            espUpdateTimer = 0
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local highlight = p.Character:FindFirstChild("UniversalESP")
                    if not highlight then
                        highlight = Instance.new("Highlight", p.Character)
                        highlight.Name, highlight.DepthMode, highlight.FillTransparency, highlight.OutlineTransparency = "UniversalESP", Enum.HighlightDepthMode.AlwaysOnTop, 0.5, 0
                    end
                    highlight.OutlineColor, highlight.FillColor = rainbowColor, rainbowColor

                    local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                    if head then
                        local nameTag = head:FindFirstChild("ESPNameTag")
                        if not nameTag then
                            nameTag = Instance.new("BillboardGui", head)
                            nameTag.Name, nameTag.Size, nameTag.StudsOffset, nameTag.AlwaysOnTop = "ESPNameTag", UDim2.new(0, 100, 0, 25), Vector3.new(0, 2, 0), true
                            local textLabel = Instance.new("TextLabel", nameTag)
                            textLabel.Name, textLabel.Size, textLabel.BackgroundTransparency, textLabel.Font, textLabel.TextSize, textLabel.TextStrokeTransparency = "Text", UDim2.new(1, 0, 1, 0), 1, Enum.Font.GothamBold, 10, 0.5
                        end
                        local tLabel = nameTag:FindFirstChild("Text")
                        if tLabel then tLabel.Text, tLabel.TextColor3 = p.DisplayName .. " (@" .. p.Name .. ")", rainbowColor end
                    end
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local highlight = p.Character:FindFirstChild("UniversalESP") if highlight then highlight:Destroy() end
                for _, descendant in pairs(p.Character:GetDescendants()) do if descendant.Name == "ESPNameTag" then descendant:Destroy() end end
            end
        end
    end
end))

-- ==================== STEPPED LOOP (TỐI ƯU VẬT LÝ) ====================
table.insert(Connections, RunService.Stepped:Connect(function(delta)
    if isUnloaded then return end
    local char = LocalPlayer.Character
    if char then
        if State.Noclip then
            for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
        end
        local hum, hrp = char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.WalkSpeed, hum.UseJumpPower, hum.JumpPower = State.WalkSpeed, true, State.JumpPower
            if State.AutoJump and hum.FloorMaterial ~= Enum.Material.Air then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
            if State.RagdollActive then hum.PlatformStand = true end
        end
        if State.AntiFling then
            antiTouchTimer = antiTouchTimer + delta
            if antiTouchTimer >= 0.5 then
                antiTouchTimer = 0
                task.spawn(function()
                    for _, otherPlayer in pairs(Players:GetPlayers()) do
                        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
                            local otherHrp = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp and otherHrp and (hrp.Position - otherHrp.Position).Magnitude < 40 then
                                for _, part in pairs(otherPlayer.Character:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end end
                            end
                        end
                    end
                end)
            end
        end
        if State.AntiSlap and hrp then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    for _, child in pairs(part:GetChildren()) do
                        if child:IsA("BodyVelocity") or child:IsA("BodyThrust") or child:IsA("LinearVelocity") or child:IsA("VectorVelocity") or child:IsA("BodyForce") or child:IsA("BodyGyro") or child:IsA("BodyPosition") or child:IsA("AlignPosition") or child:IsA("VectorForce") or child:IsA("Torque") then
                            if not (State.FlyActive and (child == flyBv or child == flyBg)) then child:Destroy() end
                        end
                    end
                end
            end
            if hrp.AssemblyLinearVelocity.Magnitude > 150 and not State.TimeRewindActive then hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0) end
            if hum and not State.FlyActive and not State.RagdollActive then
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false) hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            end
        end
    end
end))

