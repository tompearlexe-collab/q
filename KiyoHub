            SubAutoClickBtn.BackgroundColor3, SubAutoClickBtn.TextColor3, SubAutoClickStroke.Color = Color3.fromRGB(0, 160, 100), Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 230, 140)
            return
